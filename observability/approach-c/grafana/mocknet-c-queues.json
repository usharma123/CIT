    {
      "id": 7,
      "title": "Queue arrivals and terminal departures per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mocknet-c-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "description": "One arrival and one terminal departure per message. Retries are attempts, not extra departures. First/last minute buckets may be partial.",
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH events AS (\n        SELECT created_at AS at,stage,'arrived' AS flow FROM c_queue WHERE $__timeFilter(created_at)\n        UNION ALL SELECT last_event_at,stage,CASE WHEN status='FAILED' THEN 'failed' WHEN outcome='rejected' THEN 'rejected' ELSE 'completed' END\n        FROM c_queue WHERE status IN('DONE','FAILED') AND $__timeFilter(last_event_at))\n        SELECT date_trunc('minute',at) AS time,stage||' '||flow AS metric,count(*)::double precision AS value\n        FROM events WHERE stage ~ ${stage:sqlstring} AND stage<>'DEAD_LETTER' GROUP BY 1,2 ORDER BY 1,2",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
