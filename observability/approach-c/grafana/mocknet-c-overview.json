  ],
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "2026-09-29T13:11:01.973000+00:00",
    "to": "2026-09-29T13:16:27.425000+00:00"
  },
  "links": [
    {
      "type": "link",
      "title": "Business overview",
      "url": "/d/mocknet-c-business",
      "keepTime": true
    },
    {
      "type": "link",
