          "rawSql": "SELECT count(*) FILTER(WHERE business_state='Received / processing') AS \"Validating\",count(*) FILTER(WHERE business_state='Waiting for counterparty') AS \"Waiting for counterparty\",count(*) FILTER(WHERE business_state='Matched') AS \"Matched \u00b7 netting\",count(*) FILTER(WHERE business_state='Netted; output evidence missing') AS \"Output evidence missing\",count(*) FILTER(WHERE business_state='Instructions ready') AS \"Instructions ready\",count(*) FILTER(WHERE business_state='Rejected') AS \"Rejected\",count(*) FILTER(WHERE business_state='Failed') AS \"Failed\" FROM c_process_summary WHERE $__timeFilter(admitted_at) AND (${search:sqlstring}='' OR business_id=${search:sqlstring} OR operation_id=${search:sqlstring})",
