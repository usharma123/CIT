    {
      "id": 6,
      "title": "Time to milestone vs target",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mocknet-c-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Elapsed time from receipt to the selected SLA milestone, grouped relative to its demo target, with the trade count. Open trades use time waited so far, so an open trade already past target shows as breached. Failed, rejected (excluded) and unknown trades have no meaningful duration; see Needs attention and the trade list.",
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH t AS (SELECT target_seconds AS x FROM c_sla_policy WHERE policy_id=${policy:sqlstring}),buckets(n,lo,hi) AS (VALUES (1,0.0,0.5),(2,0.5,1.0),(3,1.0,2.0),(4,2.0,NULL)),labelled AS (SELECT n,lo*x AS lo_s,hi*x AS hi_s,CASE n WHEN 1 THEN 'Under '||c_format_duration(hi*x) WHEN 4 THEN 'Over '||c_format_duration(lo*x) ELSE c_format_duration(lo*x)||' \u2013 '||c_format_duration(hi*x) END||CASE n WHEN 1 THEN '  (fast)' WHEN 2 THEN '  (within target)' WHEN 3 THEN '  (late)' ELSE '  (very late)' END AS bucket FROM buckets CROSS JOIN t),trades AS (SELECT elapsed_seconds,sla_status FROM c_process_sla WHERE $__timeFilter(admitted_at) AND (${search:sqlstring}='' OR business_id=${search:sqlstring} OR operation_id=${search:sqlstring}) AND policy_id=${policy:sqlstring} AND sla_status IN('Met','In progress','At risk','Breached','Stale')) SELECT l.bucket||'  \u00b7  '||count(s.*) AS bucket,count(s.*) FILTER(WHERE s.sla_status='Met') AS \"Met\",count(s.*) FILTER(WHERE s.sla_status='In progress') AS \"In progress\",count(s.*) FILTER(WHERE s.sla_status='At risk') AS \"At risk\",count(s.*) FILTER(WHERE s.sla_status='Breached') AS \"Breached\",count(s.*) FILTER(WHERE s.sla_status='Stale') AS \"Stale\" FROM labelled l LEFT JOIN trades s ON s.elapsed_seconds>=l.lo_s AND (l.hi_s IS NULL OR s.elapsed_seconds<l.hi_s) GROUP BY l.n,l.bucket ORDER BY l.n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisLabel": "Trades",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Met"
            },
            "properties": [
              {
