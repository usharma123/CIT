          "refId": "A",
          "rawSql": "WITH selected AS (SELECT operation_id FROM support.operations WHERE (${business_id:sqlstring}='' OR business_id=${business_id:sqlstring} OR operation_id=${business_id:sqlstring}) ORDER BY accepted_at DESC LIMIT 50), related AS (SELECT operation_id FROM selected UNION SELECT related_operation_id FROM support.operation_links WHERE operation_id IN (SELECT operation_id FROM selected)) SELECT o.trace_id,o.business_id,o.operation_id,o.outcome FROM support.operations o JOIN related r USING(operation_id) ORDER BY o.accepted_at LIMIT 100",
