{
  "uid": "mocknet-stages",
  "title": "Approach A | Queue and stage diagnostics",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "tags": [
    "mocknet",
    "L3",
    "Approach A",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Service overview",
      "type": "link",
      "url": "/d/mocknet-traces",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Stage diagnostics",
      "type": "link",
      "url": "/d/mocknet-stages",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Operation investigation",
      "type": "link",
      "url": "/d/mocknet-operation",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Compare Approach B",
      "type": "link",
      "url": "/d/mocknet-b-overview",
      "keepTime": true
    },
    {
      "title": "Compare Approach C",
      "type": "link",
      "url": "http://localhost:3302/d/mocknet-c-overview",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mocknet-prometheus"
        },
        "query": "label_values(mocknet_snapshot_timestamp, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mocknet-prometheus"
        },
        "query": "label_values(mocknet_snapshot_timestamp, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mocknet-prometheus"
        },
        "query": "label_values(mocknet_snapshot_timestamp, version)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "app_instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mocknet-prometheus"
        },
        "query": "label_values(mocknet_snapshot_timestamp, app_instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "custom",
        "query": "INGESTION,MATCHING,NETTING,SETTLEMENT,DEAD_LETTER",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "business_id",
        "label": "Trade or operation ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runbook \u2022 locate the bottleneck",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Rising queue age:** check workers and database waiters. **Long attempt elapsed:** inspect SQL and the first error in its trace. **Retries:** read the reason and final disposition.\n\nCheck snapshot age before trusting queue values. Alert history includes recovered incidents. Stalls and connection-pressure controls expire automatically."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "Queue depth \u2022 ready, scheduled retries, processing",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "description": "Shared database scope. max avoids duplicate snapshots from multiple app instances; version/instance filters apply to attempt metrics, not shared queues. Only successful scrapes with database snapshots less than 15 seconds old are used. A gap means unavailable evidence.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(stage,state)((mocknet_queue_messages{service=~\"$service\",environment=~\"$environment\",stage=~\"$stage\",stage!=\"DEAD_LETTER\",state=~\"ready|scheduled|processing\"} and on(job,instance) (time()-mocknet_snapshot_timestamp{service=~\"$service\",environment=~\"$environment\"} < 15) and on(job,instance) (up{job=\"mocknet\"} == 1)))",
          "legendFormat": "{{stage}} {{outcome}} {{state}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 3,
      "title": "Oldest work \u2022 waiting versus processing",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "description": " Only successful scrapes with database snapshots less than 15 seconds old are used. A gap means unavailable evidence.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(stage,state)((mocknet_queue_oldest_seconds{service=~\"$service\",environment=~\"$environment\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"} and on(job,instance) (time()-mocknet_snapshot_timestamp{service=~\"$service\",environment=~\"$environment\"} < 15) and on(job,instance) (up{job=\"mocknet\"} == 1)))",
          "legendFormat": "{{stage}} {{outcome}} {{state}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 4,
      "title": "Queue arrivals and terminal departures \u00b7 per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "description": "Committed messages per complete/partial calendar minute in the selected interval. Terminal departure means DONE or FAILED, counted once per queue message; retried attempts are not departures. Failures are shown separately from successful/rejected departures. First/last buckets may be partial. Shared local database scope; no version/instance partition. Select one Stage for arrival/departure comparison. Missing buckets contain no recorded events; gaps are not connected.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH events AS (\n   SELECT created_at AS at,stage,'arrived' AS flow FROM support.queue_messages WHERE $__timeFilter(created_at)\n   UNION ALL\n   SELECT completed_at,stage,CASE WHEN status='FAILED' THEN 'failed' WHEN outcome='rejected' THEN 'rejected' ELSE 'completed' END\n   FROM support.queue_messages WHERE status IN ('DONE','FAILED') AND $__timeFilter(completed_at)\n  ) SELECT date_trunc('minute',at) AS time,stage || ' ' || flow AS metric,count(*)::double precision AS value\n  FROM events WHERE stage ~ '^(${stage:regex})$' AND stage<>'DEAD_LETTER' GROUP BY 1,2 ORDER BY 1,2"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mocknet-operations"
      }
    },
    {
      "id": 5,
      "title": "Attempt elapsed \u2022 p95 by stage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "description": "Claim to recorded disposition; includes handler and bookkeeping, excludes ready wait and final commit/export. A percentile estimate from histogram buckets; no sample for an abandoned attempt.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,stage)(rate(mocknet_processing_seconds_bucket{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} {{outcome}} {{state}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 6,
      "title": "Database pool \u2022 active / idle / pending",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\"}",
          "legendFormat": "active {{app_instance}} {{pool}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\"}",
          "legendFormat": "idle {{app_instance}} {{pool}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\"}",
          "legendFormat": "pending {{app_instance}} {{pool}}",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 7,
      "title": "Database connection acquisition \u2022 maximum",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_acquire_seconds_max{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\"}",
          "legendFormat": "{{stage}} {{app_instance}} {{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 8,
      "title": "JVM heap used / max",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",area=\"heap\"})",
          "legendFormat": "used",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",area=\"heap\"})",
          "legendFormat": "max",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 9,
      "title": "GC pause \u2022 seconds / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "suffix:s/s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} {{outcome}} {{state}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 10,
      "title": "Configured workers",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 8,
        "h": 5
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
