      "gridPos": {
        "x": 8,
        "y": 63,
        "w": 8,
        "h": 5
      },
      "description": "Latest poll from any worker in the stage; not proof that every configured worker is alive.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
