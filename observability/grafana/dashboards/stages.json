                "id": "custom.cellOptions",
                "value": {
                  "type": "data-links"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_from"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
