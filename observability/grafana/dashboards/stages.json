          "expr": "mocknet_worker_paused{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"}",
          "legendFormat": "{{stage}} {{app_instance}} {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 13,
      "title": "Failure signatures \u2022 committed attempt history",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "FAILED": {
                        "color": "red",
                        "index": 0
                      },
                      "REJECTED": {
                        "color": "orange",
                        "index": 1
                      },
                      "COMPLETED": {
                        "color": "green",
                        "index": 2
                      },
                      "AWAITING_COUNTERPARTY": {
                        "color": "blue",
                        "index": 3
                      },
                      "retried": {
                        "color": "orange",
                        "index": 4
                      },
                      "failed": {
                        "color": "red",
                        "index": 5
                      },
                      "completed": {
                        "color": "green",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT stage,reason,outcome,count(*) AS attempts,count(DISTINCT operation_id) AS operations,max(finished_at) AS last_seen FROM support.attempts WHERE $__timeFilter(claimed_at) AND stage ~ '^(${stage:regex})$' AND (${business_id:sqlstring}='' OR business_id=${business_id:sqlstring} OR operation_id=${business_id:sqlstring}) AND outcome IN ('failed','retried','abandoned') GROUP BY stage,reason,outcome ORDER BY attempts DESC LIMIT 30",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mocknet-operations"
      }
    },
    {
      "id": 14,
      "title": "Recent attempts \u2022 trace drilldown",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 75,
        "w": 24,
        "h": 10
      },
      "description": "Latest 100 attempts by claim time, including successful attempts. This is a bounded event table, not an operation count.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/d/mocknet-operation?${__url_time_range}&var-trace_id=${__value.raw}&var-business_id=${business_id:percentencode}&var-environment=${environment:percentencode}&var-service=${service:percentencode}&var-version=${version:percentencode}&var-app_instance=${app_instance:percentencode}&var-stage=${stage:percentencode}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "business_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate trade",
