      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH work AS (\n SELECT q.*, CASE WHEN stage='DEAD_LETTER' THEN 'dead_letter' WHEN status='PROCESSING' THEN 'processing'\n   WHEN available_at>now() THEN 'scheduled' ELSE 'ready' END AS state\n FROM support.queue_messages q WHERE status IN ('NEW','PROCESSING') AND stage ~ '^(${stage:regex})$'\n AND (${business_id:sqlstring}='' OR business_id=${business_id:sqlstring} OR operation_id=${business_id:sqlstring})\n ORDER BY CASE WHEN stage='DEAD_LETTER' THEN 3 WHEN status='PROCESSING' THEN 0 WHEN available_at<=now() THEN 1 ELSE 2 END,\n CASE WHEN stage='DEAD_LETTER' THEN -extract(epoch FROM created_at) ELSE extract(epoch FROM created_at) END LIMIT 100\n)\nSELECT CASE WHEN q.stage='DEAD_LETTER' THEN COALESCE(failed.stage,'Unknown') || ' \u2192 DLQ' ELSE q.stage END AS stage,\n q.business_id,q.state,extract(epoch FROM now()-q.created_at) AS queued_age_s,\n CASE WHEN q.stage='DEAD_LETTER' THEN failed.failed_attempts ELSE q.failed_attempts END AS failed_attempts,\n a.reason,COALESCE(q.worker_name,failed.worker_name) AS worker_name,q.operation_id,q.trace_id,\n (extract(epoch FROM COALESCE((SELECT min(created_at) FROM support.queue_messages root WHERE root.operation_id=q.operation_id),q.created_at))*1000-60000)::bigint AS trace_from\nFROM work q LEFT JOIN LATERAL (\n SELECT stage,failed_attempts,worker_name FROM support.queue_messages source WHERE q.stage='DEAD_LETTER' AND source.operation_id=q.operation_id AND source.status='FAILED' ORDER BY source.completed_at DESC LIMIT 1\n) failed ON true LEFT JOIN LATERAL (\n SELECT reason FROM support.attempts a WHERE a.operation_id=q.operation_id AND (q.stage='DEAD_LETTER' OR a.queue_message_id=q.id) AND reason IS NOT NULL ORDER BY claimed_at DESC LIMIT 1\n) a ON true\nORDER BY CASE q.state WHEN 'processing' THEN 0 WHEN 'ready' THEN 1 WHEN 'scheduled' THEN 2 ELSE 3 END,\n CASE WHEN q.state='dead_letter' THEN -extract(epoch FROM q.created_at) ELSE extract(epoch FROM q.created_at) END",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mocknet-operations"
      }
    },
    {
      "id": 22,
      "title": "Ready wait before processing \u00b7 p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "description": "Wait from ready time to claim, recorded only after an attempt finishes. Delayed retries are excluded. Read together with oldest-ready age: work never claimed has no histogram sample.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,stage)(rate(mocknet_queue_wait_seconds_bucket{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    },
    {
      "id": 23,
      "title": "Retry share of finished attempts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "description": "Attempt ratio, not the percentage of failed business operations. A retry can recover. Undefined when there are no finished attempts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(stage)(rate(mocknet_processing_seconds_count{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\",outcome=\"retried\"}[$__rate_interval])) / sum by(stage)(rate(mocknet_processing_seconds_count{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "mocknet-prometheus"
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "First observed worker version",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "mocknet-operations"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#B877D9",
        "rawQuery": true,
        "rawSql": "SELECT observed AS time, 'First observed ' || service_version AS text, instance AS tags FROM (SELECT min(claimed_at) AS observed,service_version,instance FROM support.attempts WHERE service_version IS NOT NULL GROUP BY service_version,instance) versions WHERE $__timeFilter(observed)"
      }
    ]
  }
