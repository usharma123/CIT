        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-mocknet_worker_heartbeat_timestamp{service=~\"$service\",environment=~\"$environment\",version=~\"$version\",app_instance=~\"$app_instance\",stage=~\"$stage\",stage!=\"DEAD_LETTER\"}",
          "legendFormat": "{{stage}} {{app_instance}} {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
