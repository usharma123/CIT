    },
    {
      "id": 12,
      "title": "Paused consumers",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 63,
        "w": 8,
        "h": 5
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
